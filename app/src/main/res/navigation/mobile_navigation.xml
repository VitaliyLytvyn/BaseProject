<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            app:startDestination="@+id/home_dest">

    <fragment
            android:id="@+id/authFragment"
            android:name="com.skyver.trybase.presentation.AuthFragment"
            android:label="@string/login"
            tools:layout="@layout/splash_layout">
        <action
                android:id="@+id/action_splashFragment_to_homeFragment"
                app:destination="@id/home_dest"
                app:popUpTo="@id/authFragment"
                app:popUpToInclusive="true"/>
    </fragment>
    <!--these 2 lines make it not return to this fragment on back button pressed-->
    <!--app:popUpTo="@id/authFragment"-->
    <!--app:popUpToInclusive="true"-->

    <fragment
            android:id="@+id/home_dest"
            android:name="com.skyver.trybase.presentation.HomeFragment"
            android:label="@string/home"
            tools:layout="@layout/home_fragment">
        <action
                android:id="@+id/next_action"
                app:destination="@+id/flow_step_one_dest"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_left"
                app:popExitAnim="@anim/slide_out_right"/>

    </fragment>

    <fragment
            android:id="@+id/flow_step_one_dest"
            android:name="com.skyver.trybase.presentation.FlowStepFragment"
            tools:layout="@layout/flow_step_one_fragment">
        <argument
                android:name="flowStepNumber"
                app:argType="integer"
                android:defaultValue="1"/>

        <action
                android:id="@+id/next_action"
                app:destination="@+id/flow_step_two_dest">
        </action>
    </fragment>

    <fragment
            android:id="@+id/flow_step_two_dest"
            android:name="com.skyver.trybase.presentation.FlowStepFragment"
            tools:layout="@layout/flow_step_two_fragment">

        <argument
                android:name="flowStepNumber"
                app:argType="integer"
                android:defaultValue="2"/>

        <action
                android:id="@+id/next_action"
                app:popUpTo="@id/home_dest">
        </action>
    </fragment>


</navigation>
